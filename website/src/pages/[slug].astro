---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../components/docs/DocsLayout.astro';
import { docsNav, getAdjacent } from '../lib/docs';

export async function getStaticPaths() {
	const entries = await getCollection('docs', ({ id }) => !id.startsWith('es/'));
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const locale = 'en';
const slug = entry.id;
const nav = docsNav[locale];
const { prev, next } = getAdjacent(slug, locale);
const base = import.meta.env.BASE_URL;
const markdownUrl = `${base}${slug}.md`;
---

<DocsLayout
	locale={locale}
	nav={nav}
	title={entry.data.title}
	description={entry.data.description}
	currentSlug={slug}
	headings={headings}
	prev={prev}
	next={next}
	markdownUrl={markdownUrl}
>
	<Content />
</DocsLayout>
