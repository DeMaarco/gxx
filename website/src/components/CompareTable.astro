---
interface Props {
	locale?: 'en' | 'es';
}

const { locale = 'en' } = Astro.props;

const content = {
	en: {
		label: 'Compare',
		title: 'Narrow on purpose',
		intro:
			'Inspired by <a href="https://github.com/vercel-labs/fx" target="_blank" rel="noopener">fx</a>, but focused: OpenAI or Claude, one workspace, no TUI. Just a prompt.',
		rows: [
			{ aspect: 'Interface', gxx: 'Simple REPL prompt', alt: 'Complex TUI or heavy IDE' },
			{ aspect: 'Scope', gxx: 'One directory, strict sandbox', alt: 'Multi-root, broad access' },
			{ aspect: 'Providers', gxx: 'OpenAI or Claude', alt: 'Multi-provider, plugins' },
			{ aspect: 'Modes', gxx: 'Agent / Ask / Plan', alt: 'Single mode or confusing' },
			{ aspect: 'Privacy', gxx: 'store:false, secrets blocked', alt: 'Varies' },
			{ aspect: 'Install', gxx: 'curl script, Go binary', alt: 'npm global, Docker' },
		],
	},
	es: {
		label: 'Comparar',
		title: 'Acotado a propósito',
		intro:
			'Inspirado en <a href="https://github.com/vercel-labs/fx" target="_blank" rel="noopener">fx</a>, pero enfocado: OpenAI o Claude, un workspace, sin TUI. Solo un prompt.',
		rows: [
			{ aspect: 'Interfaz', gxx: 'Prompt REPL simple', alt: 'TUI compleja o IDE pesado' },
			{ aspect: 'Alcance', gxx: 'Un directorio, sandbox estricto', alt: 'Multi-root, acceso amplio' },
			{ aspect: 'Proveedores', gxx: 'OpenAI o Claude', alt: 'Multi-provider, plugins' },
			{ aspect: 'Modos', gxx: 'Agent / Ask / Plan', alt: 'Modo único o confuso' },
			{ aspect: 'Privacidad', gxx: 'store:false, secretos bloqueados', alt: 'Variable' },
			{ aspect: 'Instalación', gxx: 'Script curl, binario Go', alt: 'npm global, Docker' },
		],
	},
};

const t = content[locale];
---

<section class="section compare-table">
	<span class="section-label">{t.label}</span>
	<h2>{t.title}</h2>
	<p class="section-intro" set:html={t.intro} />
	<div class="compare-list">
		{
			t.rows.map((row) => (
				<div class="compare-row">
					<span class="compare-aspect">{row.aspect}</span>
					<div class="compare-values">
						<span class="compare-gxx">{row.gxx}</span>
						<span class="compare-alt">{row.alt}</span>
					</div>
				</div>
			))
		}
	</div>
</section>

<style>
	.compare-list {
		border: 1px solid var(--gxx-border);
		border-radius: var(--gxx-radius-lg);
		overflow: hidden;
	}

	.compare-row {
		display: grid;
		grid-template-columns: 8rem 1fr;
		gap: 1.5rem;
		padding: 1rem 1.25rem;
		border-bottom: 1px solid var(--gxx-border);
		align-items: start;
	}

	.compare-row:last-child {
		border-bottom: none;
	}

	.compare-aspect {
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--gxx-text-muted);
	}

	.compare-values {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.compare-gxx {
		font-size: 0.875rem;
		color: var(--gxx-text);
	}

	.compare-alt {
		font-size: 0.875rem;
		color: var(--gxx-text-muted);
	}

	@media (max-width: 640px) {
		.compare-row {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}

		.compare-values {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}

		.compare-gxx::before {
			content: 'gxx · ';
			color: var(--gxx-text-muted);
			font-size: 0.75rem;
		}
	}
</style>
