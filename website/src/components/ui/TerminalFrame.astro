---
interface Props {
	label: string;
	title?: string;
	class?: string;
}

const { label, title = 'gxx', class: className = '' } = Astro.props;
---

<figure class:list={['rounded-xl border border-line bg-paper overflow-hidden font-mono text-[0.8125rem]', className]} aria-label={label}>
	<div class="grid grid-cols-[1fr_auto_1fr] items-center border-b border-line px-3.5 py-2.5" aria-hidden="true">
		<div class="flex gap-1.5">
			<span class="size-2 rounded-full bg-line"></span>
			<span class="size-2 rounded-full bg-line"></span>
			<span class="size-2 rounded-full bg-line"></span>
		</div>
		<span class="text-[0.75rem] text-muted">{title}</span>
	</div>
	<div class="p-4 sm:p-5 leading-relaxed">
		<slot />
	</div>
	<figcaption class="sr-only">{label}</figcaption>
</figure>
