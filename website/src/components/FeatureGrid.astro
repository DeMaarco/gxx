---
interface Props {
	locale?: 'en' | 'es';
	label?: string;
}

const { locale = 'en', label } = Astro.props;

const content = {
	en: {
		items: [
			{ name: 'Workspace-bound', desc: 'The directory you start in is the whole world. No traversal, no outside symlinks.' },
			{ name: 'Ask / Plan', desc: 'Shift+Tab cycles read-only ask and plan modes. After a plan, execute, request changes, or cancel.' },
			{ name: 'Git inspect', desc: 'git_status, git_diff, and git_log stay read-only and inside the workspace.' },
			{ name: 'Images', desc: 'generate_image writes GPT Image output to the workspace. Requires a platform API key.' },
			{ name: 'One-shot CLI', desc: 'gxx ask for scripts and pipes. --json for machine-readable output.' },
			{ name: 'Secret-aware', desc: '.env, keys, and credential paths are blocked. Requests use store:false.' },
		],
	},
	es: {
		items: [
			{ name: 'Acotado al workspace', desc: 'El directorio desde el que inicias es todo el mundo. Sin traversal ni symlinks externos.' },
			{ name: 'Ask / Plan', desc: 'Shift+Tab alterna modos ask y plan de solo lectura. Tras un plan: ejecutar, pedir cambios o cancelar.' },
			{ name: 'Inspección git', desc: 'git_status, git_diff y git_log permanecen de solo lectura dentro del workspace.' },
			{ name: 'Imágenes', desc: 'generate_image escribe salida GPT Image en el workspace. Requiere API key de plataforma.' },
			{ name: 'CLI one-shot', desc: 'gxx ask para scripts y pipes. --json para salida legible por máquina.' },
			{ name: 'Consciente de secretos', desc: '.env, claves y rutas de credenciales bloqueadas. Peticiones con store:false.' },
		],
	},
};

const t = content[locale];
---

<section class="mt-16 border-t border-line pt-16" aria-labelledby="features-heading">
	<h2 id="features-heading" class="mb-6 text-sm font-semibold tracking-tight text-ink">{label}</h2>
	<ul class="max-w-2xl space-y-6">
		{
			t.items.map((item) => (
				<li>
					<h3 class="text-[0.8125rem] font-semibold text-ink">{item.name}</h3>
					<p class="mt-1 text-secondary">{item.desc}</p>
				</li>
			))
		}
	</ul>
</section>
