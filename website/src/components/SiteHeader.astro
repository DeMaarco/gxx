---
import type { DocLocale } from '../../lib/docs';

interface Props {
	locale: DocLocale;
	current?: 'home' | 'docs';
	slug?: string;
}

const { locale, current, slug } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeEn = base;
const homeEs = `${base}es/`;

const enHref = slug ? `${base}${slug}/` : homeEn;
const esHref = slug ? `${base}es/${slug}/` : homeEs;

const labels = {
	en: {
		docs: 'docs',
		install: 'install',
		quickStart: 'quick start',
		updates: 'updates',
		source: 'source',
		nav: 'Site',
		lang: 'Language',
	},
	es: {
		docs: 'docs',
		install: 'instalar',
		quickStart: 'inicio rápido',
		updates: 'actualizaciones',
		source: 'source',
		nav: 'Sitio',
		lang: 'Idioma',
	},
};

const t = labels[locale];
const docsBase = locale === 'es' ? `${base}es/` : base;
const home = locale === 'es' ? homeEs : homeEn;
---

<header class="sticky top-0 z-20 flex h-12 flex-wrap items-center justify-between gap-4 border-b border-line bg-paper px-6">
	<a href={home} class="text-[0.8125rem] font-semibold tracking-tight text-ink no-underline hover:text-accent">
		gxx
	</a>
	<nav class="flex flex-wrap items-center gap-5" aria-label={t.nav}>
		<a
			href={`${docsBase}install/`}
			class="text-[0.6875rem] uppercase tracking-wider text-muted no-underline hover:text-ink"
			aria-current={current === 'docs' ? 'page' : undefined}
		>
			{t.docs}
		</a>
		<a href={`${home}#install`} class="text-[0.6875rem] uppercase tracking-wider text-muted no-underline hover:text-ink">
			{t.install}
		</a>
		<a href={`${docsBase}quick-start/`} class="text-[0.6875rem] uppercase tracking-wider text-muted no-underline hover:text-ink">
			{t.quickStart}
		</a>
		<a href={`${docsBase}updates/`} class="text-[0.6875rem] uppercase tracking-wider text-muted no-underline hover:text-ink">
			{t.updates}
		</a>
		<a
			href="https://github.com/DeMaarco/gxx"
			target="_blank"
			rel="noopener noreferrer"
			class="text-[0.6875rem] uppercase tracking-wider text-muted no-underline hover:text-ink"
		>
			{t.source}
		</a>
		<div class="flex items-center gap-1" role="group" aria-label={t.lang}>
			<a
				href={enHref}
				class:list={['px-1.5 text-[0.6875rem] no-underline', locale === 'en' ? 'font-medium text-accent' : 'text-muted hover:text-ink']}
				lang="en"
				hreflang="en"
				aria-current={locale === 'en' ? 'true' : undefined}
			>
				EN
			</a>
			<a
				href={esHref}
				class:list={['px-1.5 text-[0.6875rem] no-underline', locale === 'es' ? 'font-medium text-accent' : 'text-muted hover:text-ink']}
				lang="es"
				hreflang="es"
				aria-current={locale === 'es' ? 'true' : undefined}
			>
				ES
			</a>
		</div>
	</nav>
</header>
