---
import type { DocLocale } from '../../lib/docs';

interface Props {
	locale: DocLocale;
	current?: 'home' | 'docs';
	slug?: string;
}

const { locale, current, slug } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeEn = base;
const homeEs = `${base}es/`;

const enHref = slug ? `${base}${slug}/` : homeEn;
const esHref = slug ? `${base}es/${slug}/` : homeEs;

const labels = {
	en: {
		docs: 'docs',
		install: 'install',
		quickStart: 'quick start',
		updates: 'updates',
		source: 'source',
		nav: 'Site',
		lang: 'Language',
	},
	es: {
		docs: 'docs',
		install: 'instalar',
		quickStart: 'inicio rápido',
		updates: 'actualizaciones',
		source: 'source',
		nav: 'Sitio',
		lang: 'Idioma',
	},
};

const t = labels[locale];
const docsBase = locale === 'es' ? `${base}es/` : base;
const home = locale === 'es' ? homeEs : homeEn;
---

<header class="site-header">
	<div class="site-header__inner shell">
		<a href={home} class="site-brand" aria-label="gxx home"><span class="brand-mark">gxx</span><span class="site-brand__tag">TERMINAL AGENT</span></a>
		<button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="site-navigation" data-nav-toggle><span></span><span></span><span></span><b class="sr-only">Open navigation</b></button>
		<nav id="site-navigation" class="site-nav" aria-label={t.nav} data-site-nav>
			<a href={`${home}#why`}>WHY GXX</a>
			<a href={`${home}#workspace`}>WORKSPACE</a>
			<a href={`${home}#benchmarks`}>BENCHMARKS</a>
			<a href={`${home}#install`}>{t.install}</a>
			<a href={`${docsBase}quick-start/`}>{t.docs}</a>
			<a href="https://github.com/DeMaarco/gxx" target="_blank" rel="noopener noreferrer">GITHUB <span>↗</span></a>
			<div class="lang-switch" role="group" aria-label={t.lang}><a href={enHref} class={locale === 'en' ? 'active' : ''} lang="en" hreflang="en" aria-current={locale === 'en' ? 'true' : undefined}>EN</a><a href={esHref} class={locale === 'es' ? 'active' : ''} lang="es" hreflang="es" aria-current={locale === 'es' ? 'true' : undefined}>ES</a></div>
		</nav>
	</div>
</header>

<script>
	const toggle = document.querySelector('[data-nav-toggle]');
	const nav = document.querySelector('[data-site-nav]');
	if (toggle && nav) {
		toggle.addEventListener('click', () => {
			const open = nav.classList.toggle('is-open');
			toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
		});
		nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
			nav.classList.remove('is-open');
			toggle.setAttribute('aria-expanded', 'false');
		}));
	}
</script>
