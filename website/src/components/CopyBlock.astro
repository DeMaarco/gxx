---
interface Props {
	code: string;
}

const { code } = Astro.props;
const id = `copy-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="relative my-2 rounded-xl border border-line bg-surface" data-copy-block>
	<button
		type="button"
		class="absolute right-2.5 top-2.5 rounded-md border border-line bg-paper px-2 py-1 text-[0.6875rem] uppercase tracking-wide text-muted hover:border-accent hover:text-accent"
		data-copy-target={id}
		aria-label="Copy to clipboard"
	>
		copy
	</button>
	<pre class="m-0 overflow-x-auto p-4 pr-16 text-[0.8125rem] text-ink"><code id={id} class="block whitespace-pre">{code}</code></pre>
</div>

<script>
	document.querySelectorAll('[data-copy-block]').forEach((block) => {
		const btn = block.querySelector('button');
		const code = block.querySelector('code');
		if (!btn || !code) return;

		btn.addEventListener('click', async () => {
			const text = code.textContent ?? '';
			try {
				await navigator.clipboard.writeText(text);
				btn.textContent = 'copied';
				setTimeout(() => {
					btn.textContent = 'copy';
				}, 2000);
			} catch {
				btn.textContent = 'failed';
			}
		});
	});
</script>
