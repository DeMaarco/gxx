---
import CopyBlock from './CopyBlock.astro';

interface Props {
	locale?: 'en' | 'es';
	version?: string;
}

const { locale = 'en', version = 'v0.0.20' } = Astro.props;

const content = {
	en: {
		title: 'Install',
		tabs: ['macOS / Linux', 'Windows', 'From source'],
		macos: {
			main: 'curl -fsSL https://raw.githubusercontent.com/DeMaarco/gxx/main/install.sh | sh',
			path: 'export PATH="$HOME/.local/bin:$PATH"\ngxx version',
			pin: `curl -fsSL https://raw.githubusercontent.com/DeMaarco/gxx/main/install.sh | sh -s -- --version ${version}\ncurl -fsSL https://raw.githubusercontent.com/DeMaarco/gxx/main/install.sh | sh -s -- --dir /usr/local/bin`,
			note: 'Installs to ~/.local/bin. Add it to PATH if the shell cannot find gxx.',
		},
		windows: {
			main: 'irm https://raw.githubusercontent.com/DeMaarco/gxx/main/install.ps1 | iex',
			pin: `$env:GXX_VERSION = "${version}"\nirm https://raw.githubusercontent.com/DeMaarco/gxx/main/install.ps1 | iex`,
			note: 'Installs to %LOCALAPPDATA%\\gxx. Requires Git for Windows on PATH.',
		},
		source: {
			code: `git clone https://github.com/DeMaarco/gxx.git\ncd gxx\ngo install ./cmd/gxx\ngo test ./test/...`,
			note: 'Requires Go 1.27+.',
		},
		pathLabel: 'Add to PATH',
		pinLabel: 'Pin a version',
	},
	es: {
		title: 'Instalación',
		tabs: ['macOS / Linux', 'Windows', 'Desde fuente'],
		macos: {
			main: 'curl -fsSL https://raw.githubusercontent.com/DeMaarco/gxx/main/install.sh | sh',
			path: 'export PATH="$HOME/.local/bin:$PATH"\ngxx version',
			pin: `curl -fsSL https://raw.githubusercontent.com/DeMaarco/gxx/main/install.sh | sh -s -- --version ${version}\ncurl -fsSL https://raw.githubusercontent.com/DeMaarco/gxx/main/install.sh | sh -s -- --dir /usr/local/bin`,
			note: 'Instala en ~/.local/bin. Añádelo a PATH si el shell no encuentra gxx.',
		},
		windows: {
			main: 'irm https://raw.githubusercontent.com/DeMaarco/gxx/main/install.ps1 | iex',
			pin: `$env:GXX_VERSION = "${version}"\nirm https://raw.githubusercontent.com/DeMaarco/gxx/main/install.ps1 | iex`,
			note: 'Instala en %LOCALAPPDATA%\\gxx. Requiere Git for Windows en PATH.',
		},
		source: {
			code: `git clone https://github.com/DeMaarco/gxx.git\ncd gxx\ngo install ./cmd/gxx\ngo test ./test/...`,
			note: 'Requiere Go 1.27+.',
		},
		pathLabel: 'Añadir a PATH',
		pinLabel: 'Fijar versión',
	},
};

const t = content[locale];
---

<section class="mt-16 border-t border-line pt-16" id="install" aria-labelledby="install-heading">
	<h2 id="install-heading" class="mb-6 text-sm font-semibold tracking-tight text-ink">{t.title}</h2>
	<div class="mb-5 flex flex-wrap gap-5" role="tablist" aria-label={t.title}>
		{
			t.tabs.map((label, i) => (
				<button
					type="button"
					class:list={[
						'tab-btn cursor-pointer border-none bg-transparent p-0 text-[0.75rem] text-muted',
						i === 0 && 'active font-medium text-ink',
					]}
					role="tab"
					aria-selected={i === 0}
					data-tab={i}
				>
					{label}
				</button>
			))
		}
	</div>

	<div class="tab-panel max-w-3xl" data-panel="0" role="tabpanel">
		<p class="mb-4 text-secondary">{t.macos.note}</p>
		<CopyBlock code={t.macos.main} />
		<p class="mb-1 mt-5 text-xs text-muted">{t.pathLabel}</p>
		<CopyBlock code={t.macos.path} />
		<p class="mb-1 mt-5 text-xs text-muted">{t.pinLabel}</p>
		<CopyBlock code={t.macos.pin} />
	</div>

	<div class="tab-panel hidden max-w-3xl" data-panel="1" role="tabpanel" hidden>
		<p class="mb-4 text-secondary">{t.windows.note}</p>
		<CopyBlock code={t.windows.main} />
		<p class="mb-1 mt-5 text-xs text-muted">{t.pinLabel}</p>
		<CopyBlock code={t.windows.pin} />
	</div>

	<div class="tab-panel hidden max-w-3xl" data-panel="2" role="tabpanel" hidden>
		<p class="mb-4 text-secondary">{t.source.note}</p>
		<CopyBlock code={t.source.code} />
	</div>
</section>

<script>
	document.querySelectorAll('#install').forEach((section) => {
		const tabs = section.querySelectorAll('.tab-btn');
		const panels = section.querySelectorAll('.tab-panel');

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const index = tab.getAttribute('data-tab');

				tabs.forEach((t) => {
					t.classList.remove('active', 'font-medium', 'text-ink');
					t.classList.add('text-muted');
					t.setAttribute('aria-selected', 'false');
				});
				panels.forEach((p) => {
					p.classList.add('hidden');
					p.setAttribute('hidden', '');
				});

				tab.classList.add('active', 'font-medium', 'text-ink');
				tab.classList.remove('text-muted');
				tab.setAttribute('aria-selected', 'true');
				const panel = section.querySelector(`[data-panel="${index}"]`);
				if (panel) {
					panel.classList.remove('hidden');
					panel.removeAttribute('hidden');
				}
			});
		});
	});
</script>
