---
import type { LandingLocale } from '../../lib/landing';
import { landingContent } from '../../lib/landing';

interface Props {
	locale?: LandingLocale;
}

const { locale = 'en' } = Astro.props;
const t = landingContent(locale);
const base = import.meta.env.BASE_URL;
---

<section class="mt-16 border-t border-line pt-16" aria-labelledby="diagram-heading">
	<h2 id="diagram-heading" class="mb-2 text-sm font-semibold tracking-tight text-ink">
		{t.diagramTitle}
	</h2>
	<p class="mb-8 max-w-2xl text-secondary">{t.diagramIntro}</p>

	<figure class="mx-auto max-w-lg" role="img" aria-label={t.diagramTitle}>
		<svg viewBox="0 0 420 260" class="w-full text-ink" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
			<rect x="20" y="20" width="380" height="220" rx="12" fill="none" stroke="currentColor" stroke-opacity="0.15" stroke-width="1.5" stroke-dasharray="6 4"/>
			<text x="40" y="48" fill="currentColor" fill-opacity="0.45" font-family="IBM Plex Mono, monospace" font-size="11">parent directories (blocked)</text>
			<rect x="60" y="70" width="300" height="140" rx="10" fill="#f5f5f4" stroke="#7c3aed" stroke-width="2"/>
			<text x="80" y="98" fill="#7c3aed" font-family="IBM Plex Mono, monospace" font-size="12" font-weight="600">~/your-project/</text>
			<rect x="88" y="112" width="120" height="28" rx="6" fill="#fafaf9" stroke="#e7e5e4"/>
			<text x="100" y="130" fill="#57534e" font-family="IBM Plex Mono, monospace" font-size="10">src/</text>
			<rect x="220" y="112" width="120" height="28" rx="6" fill="#fafaf9" stroke="#e7e5e4"/>
			<text x="232" y="130" fill="#57534e" font-family="IBM Plex Mono, monospace" font-size="10">tests/</text>
			<rect x="88" y="152" width="252" height="28" rx="6" fill="#fafaf9" stroke="#e7e5e4"/>
			<text x="100" y="170" fill="#57534e" font-family="IBM Plex Mono, monospace" font-size="10">gxx prompt &gt;</text>
			<path d="M 210 230 L 210 210" stroke="#0891b2" stroke-width="1.5" marker-end="url(#arrow)"/>
			<text x="170" y="248" fill="#0891b2" font-family="IBM Plex Mono, monospace" font-size="10">tools stay inside</text>
			<defs>
				<marker id="arrow" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
					<path d="M0,0 L6,3 L0,6 Z" fill="#0891b2"/>
				</marker>
			</defs>
		</svg>
		<figcaption class="sr-only">{t.diagramIntro}</figcaption>
	</figure>
</section>

<section class="mt-16 border-t border-line pt-16" aria-labelledby="screens-heading">
	<h2 id="screens-heading" class="mb-2 text-sm font-semibold tracking-tight text-ink">
		{t.screenshotsTitle}
	</h2>
	<p class="mb-8 max-w-2xl text-secondary">{t.screenshotsIntro}</p>
	<div class="grid gap-6 md:grid-cols-3">
		<figure>
			<img
				src={`${base}screenshots/gxx-repl.jpg`}
				alt={t.screens.repl}
				width="800"
				height="600"
				loading="lazy"
				decoding="async"
				class="w-full rounded-xl border border-line"
			/>
			<figcaption class="mt-2 text-xs text-muted">{t.screens.repl}</figcaption>
		</figure>
		<figure>
			<img
				src={`${base}screenshots/gxx-modes.jpg`}
				alt={t.screens.modes}
				width="800"
				height="600"
				loading="lazy"
				decoding="async"
				class="w-full rounded-xl border border-line"
			/>
			<figcaption class="mt-2 text-xs text-muted">{t.screens.modes}</figcaption>
		</figure>
		<figure>
			<img
				src={`${base}screenshots/gxx-plan-menu.jpg`}
				alt={t.screens.plan}
				width="800"
				height="600"
				loading="lazy"
				decoding="async"
				class="w-full rounded-xl border border-line"
			/>
			<figcaption class="mt-2 text-xs text-muted">{t.screens.plan}</figcaption>
		</figure>
	</div>
</section>
