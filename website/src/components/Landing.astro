---
import SiteHeader from './SiteHeader.astro';
import SpecsSection from './landing/SpecsSection.astro';
import InterfaceGallery from './landing/InterfaceGallery.astro';
import VisualSection from './landing/VisualSection.astro';
import FeatureGrid from './FeatureGrid.astro';
import Principles from './Principles.astro';
import InstallTabs from './InstallTabs.astro';
import { landingContent } from '../lib/landing';
import '../styles/app.css';

interface Props {
	locale?: 'en' | 'es';
}

const { locale = 'en' } = Astro.props;
const t = landingContent(locale);
const base = import.meta.env.BASE_URL;
const docsBase = locale === 'es' ? `${base}es/` : base;
---

<!doctype html>
<html lang={t.lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={t.description} />
		<meta property="og:title" content={t.title} />
		<meta property="og:description" content={t.description} />
		<meta property="og:type" content="website" />
		<title>{t.title}</title>
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<a href="#main-content" class="skip-link">{locale === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
		<SiteHeader locale={locale} current="home" />

		<main id="main-content" class="mx-auto max-w-4xl px-6 pb-20 pt-12">
			<section class="mb-10" aria-labelledby="hero-heading">
				<h1 id="hero-heading" class="mb-5 max-w-2xl text-base font-semibold tracking-tight text-ink">
					{t.headline}
				</h1>
				<div class="flex max-w-3xl flex-wrap items-start gap-3 text-secondary">
					<span class="font-medium text-accent" aria-hidden="true">$</span>
					<code id="hero-install-cmd" class="min-w-0 flex-1 overflow-x-auto whitespace-pre text-ink">
						{t.installCmd}
					</code>
					<button
						type="button"
						class="shrink-0 rounded-md border border-line px-2 py-1 text-[0.6875rem] uppercase tracking-wide text-muted hover:border-accent hover:text-accent"
						data-copy={t.installCmd}
						data-copy-label={t.copy}
						data-copied-label={t.copied}
						data-failed-label={t.failed}
						aria-label={locale === 'es' ? 'Copiar comando de instalación' : 'Copy install command'}
					>
						{t.copy}
					</button>
				</div>

				<figure class="mt-10">
					<img
						src={`${base}screenshots/gxx-repl.jpg`}
						alt={t.heroImageAlt}
						width="1200"
						height="720"
						fetchpriority="high"
						decoding="async"
						class="w-full rounded-xl border border-line shadow-sm"
					/>
					<figcaption class="mt-2 text-xs text-muted">{t.screens.repl}</figcaption>
				</figure>
			</section>

			<div class="prose-gxx mt-10 max-w-2xl space-y-4 text-secondary">
				{t.about.map((p) => <p>{p}</p>)}
			</div>

			<SpecsSection locale={locale} version={t.version} />
			<InterfaceGallery locale={locale} version={t.version} />
			<VisualSection locale={locale} />
			<Principles locale={locale} title={t.principlesTitle} />
			<FeatureGrid locale={locale} label={t.featuresLabel} />
			<InstallTabs locale={locale} version={t.version} />
		</main>

		<footer class="border-t border-line px-6 py-6">
			<p class="mx-auto flex max-w-4xl flex-wrap gap-4 text-[0.6875rem] uppercase tracking-wide text-muted">
				<a href="https://github.com/DeMaarco/gxx/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="no-underline hover:text-accent">
					{t.footerLicense}
				</a>
				<a href="https://github.com/DeMaarco/gxx" target="_blank" rel="noopener noreferrer" class="no-underline hover:text-accent">
					{t.footerSource}
				</a>
				<a href={`${docsBase}install/`} class="no-underline hover:text-accent">{t.footerDocs}</a>
				<a href={`${docsBase}updates/`} class="no-underline hover:text-accent">{t.footerUpdates}</a>
			</p>
		</footer>

		<script>
			document.querySelectorAll('[data-copy]').forEach((btn) => {
				const copyLabel = btn.getAttribute('data-copy-label') ?? 'copy';
				const copiedLabel = btn.getAttribute('data-copied-label') ?? 'copied';
				const failedLabel = btn.getAttribute('data-failed-label') ?? 'failed';

				btn.addEventListener('click', async () => {
					const text = btn.getAttribute('data-copy') ?? '';
					try {
						await navigator.clipboard.writeText(text);
						btn.textContent = copiedLabel;
						btn.setAttribute('aria-live', 'polite');
						setTimeout(() => {
							btn.textContent = copyLabel;
						}, 2000);
					} catch {
						btn.textContent = failedLabel;
					}
				});
			});
		</script>
	</body>
</html>
